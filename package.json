{
  "name": "@fethcat/version",
  "version": "0.0.17",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "files": [
    "dist",
    "package.json"
  ],
  "license": "ISC",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier -w \"{src,tests}/**/*.ts\"",
    "lint": "eslint \"{src,tests}/**/*.ts\"",
    "test": "vitest run --coverage",
    "version:patch": "pnpm build && node ./dist/index.js patch",
    "version:minor": "pnpm build && node ./dist/index.js minor",
    "version:major": "pnpm build && node ./dist/index.js major"
  },
  "bin": {
    "fethca-version": "dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fethca/version.git"
  },
  "devDependencies": {
    "@fethcat/eslint-plugin": "^0.0.4",
    "@fethcat/prettier-config": "^1.0.5",
    "@fethcat/tests": "^0.0.16",
    "@types/node": "^24.19.4",
    "@vitest/coverage-v8": "^5.1.2",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  },
  "dependencies": {
    "async-exec": "^1.1.0"
  },
  "prettier": "@fethcat/prettier-config",
  "engines": {
    "node": ">=24"
  }
}
